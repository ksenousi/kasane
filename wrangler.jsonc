{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kasane",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  // The built app is served as static assets; only /api/* runs the Worker.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kasane",
      "database_id": "da356d57-0038-42c8-8d29-17b642c72207",
      "migrations_dir": "migrations"
    }
  ],
  // Sign-in attempts: 5 a minute from one IP, 20 a minute in total. Counts are per Cloudflare location.
  "ratelimits": [
    { "name": "LOGIN_PER_IP", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "LOGIN_TOTAL", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
